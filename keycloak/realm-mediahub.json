{
  "realm": "mediahub",
  "displayName": "MediaHub",
  "enabled": true,
  "sslRequired": "none",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "loginTheme": "mediahub",

  "roles": {
    "realm": [
      { "name": "staff", "description": "MediaHub staff: may use the Admin Console." }
    ]
  },

  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_VIEW\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"Display name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"birthdate\",\"displayName\":\"Date of birth\",\"validations\":{\"iso-date\":{}},\"annotations\":{\"inputType\":\"html5-date\",\"inputHelperTextAfter\":\"Film Library shows films by age and UK BBFC rating.\"},\"selector\":{\"scopes\":[\"Films.Read\"]},\"required\":{\"roles\":[\"user\"],\"scopes\":[\"Films.Read\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },

  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject (sub) in every token.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Display name, for the app to greet the user.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "firstName", "claim.name": "name", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "false", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email address.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles (e.g. staff) as a flat roles claim.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "false" }
        }
      ]
    },
    {
      "name": "Films.Read",
      "description": "Film Library API. Adds scp, the film-library-api audience and the user's birthdate (the only scope that carries it).",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "scp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "scp", "claim.value": "Films.Read", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "film-library-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "birthdate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "birthdate", "claim.name": "birthdate", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        }
      ]
    },
    {
      "name": "Music.Read",
      "description": "Music Library API. Adds scp and the music-library-api audience.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "scp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "scp", "claim.value": "Music.Read", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "music-library-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "profile"],
  "defaultOptionalClientScopes": [],

  "clients": [
    {
      "clientId": "film-library-web",
      "name": "Film Library",
      "description": "React SPA. Age-restricted films; the only app that receives the birthdate claim.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": ["http://localhost:5173", "http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173##http://localhost:5173/*",
        "login_theme": "filmlibrary"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["Films.Read"]
    },
    {
      "clientId": "music-library-web",
      "name": "Music Library",
      "description": "React SPA (example app). Shares accounts and single sign-on; never sees the birthdate.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:5174",
      "redirectUris": ["http://localhost:5174", "http://localhost:5174/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174##http://localhost:5174/*"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["Music.Read"]
    },
    {
      "clientId": "admin-console",
      "name": "Admin Console",
      "description": "Server-side web app (example app). Confidential client; only users with the staff role should be let in.",
      "enabled": true,
      "publicClient": false,
      "secret": "local-dev-only-admin-console-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:5175",
      "redirectUris": ["http://localhost:5175/signin-oidc"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5175/signout-callback-oidc"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": ["basic", "profile", "email", "roles"],
      "optionalClientScopes": []
    }
  ],

  "users": [
    {
      "username": "chloe@example.com",
      "email": "chloe@example.com",
      "emailVerified": true,
      "firstName": "Chloe",
      "enabled": true,
      "attributes": { "birthdate": ["2014-03-15"] },
      "realmRoles": ["default-roles-mediahub"],
      "credentials": [{ "type": "password", "value": "Film-local-chloe1!", "temporary": false }]
    },
    {
      "username": "ben@example.com",
      "email": "ben@example.com",
      "emailVerified": true,
      "firstName": "Ben",
      "enabled": true,
      "attributes": { "birthdate": ["2010-06-01"] },
      "realmRoles": ["default-roles-mediahub"],
      "credentials": [{ "type": "password", "value": "Film-local-ben1!", "temporary": false }]
    },
    {
      "username": "alice@example.com",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "enabled": true,
      "attributes": { "birthdate": ["1990-01-20"] },
      "realmRoles": ["default-roles-mediahub", "staff"],
      "credentials": [{ "type": "password", "value": "Film-local-alice1!", "temporary": false }]
    }
  ]
}
